[Service]
{% if 'http_proxy' in ansible_facts.env %}
Environment="HTTP_PROXY={{ ansible_facts.env.http_proxy }}"
{% endif %}
{% if 'https_proxy' in ansible_facts.env %}
Environment="HTTPS_PROXY={{ ansible_facts.env.https_proxy }}"
{% endif %}
{% if 'no_proxy' in ansible_facts.env %}
Environment="NO_PROXY={{ ansible_facts.env.no_proxy }}"
{% endif %}
